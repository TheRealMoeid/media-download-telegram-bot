# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# Download Configuration
DOWNLOAD_DIR=downloads/

# Keep downloaded videos on disk instead of deleting them after sending.
# Each download goes in its own downloads/req_xxxx/ folder. Nothing ever
# cleans these up automatically - delete them yourself when you like.
# Default: false
KEEP_DOWNLOADS=false

# Language preference storage (SQLite, used by services/language_service.py)
DB_PATH=bot.db

# FFmpeg executable path or name. Defaults to "ffmpeg" (resolved via PATH).
# Override only if FFmpeg is installed somewhere non-standard.
FFMPEG_PATH=ffmpeg
